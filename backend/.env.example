# ==============================================================================
# SWASTHYA-SAMPARK BACKEND ENVIRONMENT VARIABLES (EXAMPLE)
# Copy this file to .env and fill in your values
# ==============================================================================

# Application Environment (development / production)
NODE_ENV=development

# Server Port
PORT=3001

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example local: mongodb://localhost:27017/swasthya_sampark
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/swasthya_sampark?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/swasthya_sampark

# JWT Secret for User Authentication & Token Signing
JWT_SECRET=your_jwt_secret_key_change_in_production

# Google Gemini AI API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
API_KEY=your_gemini_api_key_here
API_KEY2=your_backup_gemini_api_key_here
MODEL_NAME=gemini-1.5-flash
MODEL_NAME2=gemini-1.5-pro

# Email Configuration (for consultation & notification emails via Nodemailer)
# If using Gmail: Use your Gmail address and generate a 16-character Google App Password (not your real account password)
EMAIL=your_email@gmail.com
PASS=your_gmail_app_password

# Allowed Client Origin (for CORS configuration in production, comma-separated)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# (Optional) AWS Credentials if using AWS Textract instead of Tesseract OCR
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
